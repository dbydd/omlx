+
+        async def _battery_pause_loop() -> None:
+            seen: bool | None = None
+            while True:
+                try:
+                    gs = _server_state.global_settings
+                    poll = (
+                        float(getattr(gs.server, "battery_poll_interval", 0.0))
+                        if gs
