+    def set_paused(self, paused: bool) -> None:
+        """Refuse new model loads while paused (a request returns 503).
+
+        Models already loaded keep serving: the pause stops the next one
+        from starting, which is what away-from-AC power wants. Clearing it
+        needs nothing else, the next request loads on demand.
+        """
+        if paused != self._paused:
+            self._paused = paused
+            logger.info("Engine pool %s", "paused" if paused else "resumed")
+
+    @property
+    def paused(self) -> bool:
+        """Whether new model loads are refused right now."""
+        return self._paused
+
+    async def unload_for_battery(
+        self,
+        idle_seconds: float,
+        include_pinned: bool = False,
+    ) -> list[str]:
+        """Unload loaded models idle for ``idle_seconds`` away from AC power.
+
+        Entries loading or serving a request are left alone, and the next
+        request reloads a model on demand. ``include_pinned`` also drops
+        pinned models, which the sealed state wants: a machine in a bag
+        keeps nothing resident. Returns the ids that unloaded.
+        """
+        cutoff = time.time() - max(0.0, idle_seconds)
+        unloaded = []
+        for model_id, entry in list(self._entries.items()):
+            if (
+                entry.engine is None
+                or (entry.is_pinned and not include_pinned)
+                or entry.is_loading
+                or entry.in_use > 0
+                or entry.last_access > cutoff
+            ):
+                continue
+            if include_pinned and entry.is_pinned:
+                if self._entry_has_active_requests(entry):
+                    entry.last_access = time.time()
+                    continue
+                # _unload_engine takes no lock itself; unload_if_idle_unpinned
+                # is the only caller that holds one, and this path does not.
+                await self._unload_engine(model_id)
+                unloaded.append(model_id)
+            elif await self.unload_if_idle_unpinned(model_id):
+                unloaded.append(model_id)
+        return unloaded
+
