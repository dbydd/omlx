+def _on_battery_power() -> bool | None:
+    """True on battery, False on AC, None when the power state cannot be read."""
+    if sys.platform != "darwin":
+        return None
+    try:
+        head = subprocess.run(
+            ["pmset", "-g", "ps"],
+            capture_output=True,
+            text=True,
+            timeout=5,
+            check=False,
+        ).stdout.splitlines()[0]
+    except Exception:  # pragma: no cover - pmset hiccups must not stop the loop
+        return None
+    return "AC Power" not in head
+
+
+def _lid_is_closed() -> bool | None:
+    """True when the lid is closed, False when open, None when unknown."""
+    if sys.platform != "darwin":
+        return None
+    try:
+        out = subprocess.run(
+            ["ioreg", "-r", "-d", "1", "-k", "AppleClamshellState"],
+            capture_output=True,
+            text=True,
+            timeout=5,
+            check=False,
+        ).stdout
+    except Exception:  # pragma: no cover - best-effort, like the power probe
+        return None
+    match = re.search(r'"AppleClamshellState" = (Yes|No)', out)
+    if match is None:
+        return None
+    return match.group(1) == "Yes"
+
+
+# Serving is decided by power and lid together:
+#   POWER_SERVING - on AC. The lid does not matter: a closed lid on AC is a
+#                   desk with a monitor, and models load on demand.
+#   POWER_BATTERY - on battery with the lid open: no new loads, and a model
+#                   that has been idle for battery_idle_seconds unloads. A
+#                   request that is already running still finishes.
+#   POWER_SEALED  - on battery with the lid closed, a machine in a bag:
+#                   nothing serves, and every model unloads now regardless
+#                   of the idle clock.
+POWER_SERVING = "serving"
+POWER_BATTERY = "battery"
+POWER_SEALED = "sealed"
+
+
+def _power_state() -> str | None:
+    """The current serving state, or None when it cannot be read."""
+    battery = _on_battery_power()
+    if battery is None:
+        return None
+    if not battery:
+        return POWER_SERVING
+    return POWER_SEALED if _lid_is_closed() is True else POWER_BATTERY
+
